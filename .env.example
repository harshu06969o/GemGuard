# =============================================================================
# GeM-Guard — Environment Configuration Template
# =============================================================================
# Copy to .env and fill in values. All services read from the project root.
# =============================================================================

# ─── Service Ports ───────────────────────────────────────────────────────────
BACKEND_PORT=8001
GATEWAY_PORT=3000
FRONTEND_PORT=5173

# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/gem_guard

# ─── Auth / JWT ──────────────────────────────────────────────────────────────
JWT_SECRET=supersecretjwtkey_gemguard_2026

# ─── Storage ─────────────────────────────────────────────────────────────────
STORAGE_PROVIDER=local
# Options: 'local' | 'cloudinary'
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── AI ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ─── Internal service URLs (used by gateway / Vite proxy) ──────────────────
BACKEND_URL=http://127.0.0.1:8001
VITE_PROXY_TARGET=
VITE_API_URL=

# ─── Runtime ─────────────────────────────────────────────────────────────────
USE_REAL_MONGO=0
NODE_ENV=development
APP_ENV=development
